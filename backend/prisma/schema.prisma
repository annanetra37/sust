generator client {
  provider   = "prisma-client-js"
  output     = "../node_modules/.prisma/client"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// ─── Authentication & Users ─────────────────────────────────────

model Company {
  id               String   @id @default(uuid())
  name             String
  country          String
  hqLocation       String?
  industry         String
  companySize      String
  ownershipType    String?
  yearEstablished  Int?
  legalStructure   String?
  regionsOfOp      String[] @default([])
  stockExchange    String?
  tickerSymbol     String?
  logoPath         String?      // path to uploaded company logo (PNG/JPG)
  creditBalance    Int      @default(100)
  esgStandard      String   @default("ESRS")

  // ─── Subscription tier ───────────────────────────────────────
  // 'STARTER' | 'PROFESSIONAL' | 'ENTERPRISE'
  // Feature gating + hard limits are driven by this value.  The
  // canonical tier → features map lives in services/tierFeatures.js.
  tier             String   @default("STARTER")

  // ─── Anonymous benchmark cohort opt-in ───────────────────────
  // When true, this company's aggregated KPI values contribute to the
  // sector benchmark cohorts (see BenchmarkCohort).  Only opted-in
  // companies can read cohort stats.  Withdrawal is retroactive — a
  // nightly job recomputes cohorts excluding withdrawn contributors.
  benchmarkOptIn   Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users            User[]
  orgUnits         OrgUnit[]
  creditTxns       CreditTransaction[]
  uploadHistory    UploadHistory[]
  dataConnections  DataConnection[]

  workforceComp    FS1WorkforceComposition[]
  workforceDiver   FS1WorkforceDiversity[]
  workplaceInj     FS1WorkplaceInjuries[]
  employeeTraining FS1EmployeeTraining[]
  employeeTurnover FS1EmployeeTurnover[]

  emissionActivity FE1EmissionActivityData[]
  ghgInventory     FE1GHGInventory[]
  sbtiTargets      SBTiTarget[]

  financials       CompanyFinancials?

  // PCF / Sector pack relations (Sprint 1)
  products         Product[]
  components       Component[]
  sectorSelection  CompanySectorSelection?
  suppliers        Supplier[]
  realEstateAssets RealEstateAsset[]
  financialExposures FinancialExposure[]
  isoIngestions    IsoDataIngestion[]
  griGapAnalyses   GriGapAnalysis[]

  sites            Site[]
  waterActivities  WaterActivity[]
  biodiversityAssessments BiodiversityAssessment[]
}

// ─── Sustainability ROI inputs ──────────────────────────────────
// Per-company financial assumptions used by the ROI module to translate
// emission / energy / workforce data into USD impact.  Populated from the
// ROI dashboard's "financial data" form.  Defaults mirror industry averages
// so the module still produces meaningful numbers before the CFO steps in.
model CompanyFinancials {
  id                           String  @id @default(uuid())
  companyId                    String  @unique
  company                      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Energy cost (USD per kWh) — drives the "Energy cost savings" pillar.
  electricityPricePerKwh       Float   @default(0.15)
  // Shadow / actual carbon price (USD per tCO2e) — drives the
  // "Carbon tax avoidance" pillar.
  carbonTaxPerTco2e            Float   @default(85)
  // Average fully-loaded recruiting cost per hire (USD) — drives the
  // "HR & talent ROI" pillar.
  avgRecruitingCostPerHire     Float   @default(4700)
  // Total annual revenue (USD) — drives the "Contract eligibility" pillar.
  annualRevenue                Float?
  // Share of revenue tied to contracts that require an ESG / sustainability
  // certification to win or keep.  Stored as a fraction in [0, 1].
  esgDependentRevenueShare     Float   @default(0.35)
  // Currency symbol used for display.  Storage stays in USD.
  currency                     String  @default("USD")

  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  jobTitle        String?
  role            Role      @default(CUSTOM)
  isActive        Boolean   @default(false)
  emailVerified   Boolean   @default(false)
  otpCode         String?
  otpExpiresAt    DateTime?
  otpLastSentAt   DateTime?
  resetToken      String?
  resetTokenExp   DateTime?
  inviteToken     String?
  inviteTokenExp  DateTime?
  refreshToken    String?
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  permissions     UserPermission[]
  creditTxns      CreditTransaction[]
  uploadHistory   UploadHistory[]
  activityLogs    ActivityLog[]
}

// ─── Activity Log ───────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(uuid())
  companyId   String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  detail      String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

// ─── Internal Cost Tracking (admin-only, not user-visible) ──────

model CostLog {
  id            String   @id @default(uuid())
  companyId     String
  userId        String?
  operation     String   // AI_SCHEMA_MAP, AI_CLEAN, AI_DOC_EXTRACT, AI_ASSISTANT, OCR, PDF_PARSE, REPORT_GEN
  model         String?  // claude-sonnet-4-20250514, tesseract, etc.
  inputTokens   Int?
  outputTokens  Int?
  totalTokens   Int?
  estimatedCost Float?   // USD
  durationMs    Int?     // processing time in milliseconds
  relatedId     String?  // upload ID or other reference
  metadata      Json?    // extra details (file name, rows processed, etc.)
  createdAt     DateTime @default(now())
}

enum Role {
  ADMIN
  CUSTOM
}

model UserPermission {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgUnitId String
  orgUnit   OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  canView   Boolean @default(false)
  canUpload Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([userId, orgUnitId])
}

model OrgUnit {
  id        String  @id @default(uuid())
  name      String
  country   String
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  permissions      UserPermission[]
  workforceComp    FS1WorkforceComposition[]
  workforceDiver   FS1WorkforceDiversity[]
  workplaceInj     FS1WorkplaceInjuries[]
  employeeTraining FS1EmployeeTraining[]
  employeeTurnover FS1EmployeeTurnover[]
  emissionActivity FE1EmissionActivityData[]
  ghgInventory     FE1GHGInventory[]

  products         Product[]
  sites            Site[]

  @@unique([name, companyId])
}

// ─── Credits ────────────────────────────────────────────────────

model CreditTransaction {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  transactionType String   // EXCEL_S1, EXCEL_E1, DOC_EXTRACT_E1
  creditsUsed     Int
  description     String?
  relatedFileId   String?
  createdAt       DateTime @default(now())
}

// ─── Upload History ─────────────────────────────────────────────

model UploadHistory {
  id             String       @id @default(uuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  fileName       String
  fileType       String       // E1, S1
  orgUnit        String?
  orgUnitId      String?
  status         UploadStatus @default(PROCESSING)
  totalRows      Int?
  processedRows  Int?
  errorMessage   String?
  storedFilePath String?      // path to original uploaded file on disk
  storedFileSize Int?         // file size in bytes
  storedFileMime String?      // MIME type
  auditStatus    String?      @default("pending") // pending, verified, flagged, rejected
  auditNote      String?
  auditedBy      String?
  auditedAt      DateTime?
  deletedAt      DateTime?     // when the underlying data was deleted
  deletedBy      String?       // who deleted it
  deletedNote    String?       // deletion details
  createdAt      DateTime     @default(now())
  completedAt    DateTime?
}

enum UploadStatus {
  PROCESSING
  COMPLETED
  FAILED
}

// ─── S1: Own Workforce ──────────────────────────────────────────

model FS1WorkforceComposition {
  id            String  @id @default(uuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgUnitId     String
  orgUnit       OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  year          Int
  quarter       Int?
  gender        String  // Male, Female, Non-binary, Not disclosed
  contractType  String  // Permanent, Temporary, Part-time, Full-time
  country       String?
  employeeCount Int
  createdAt     DateTime @default(now())
}

model FS1WorkforceDiversity {
  id               String  @id @default(uuid())
  companyId        String
  company          Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgUnitId        String
  orgUnit          OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  year             Int
  quarter          Int?
  gender           String
  disabilityStatus String  // Yes, No, Not disclosed
  disabilityType   String?
  count            Int
  createdAt        DateTime @default(now())
}

model FS1WorkplaceInjuries {
  id           String  @id @default(uuid())
  companyId    String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgUnitId    String
  orgUnit      OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  year         Int
  quarter      Int?
  injuryType   String
  injuryStatus String  // Fatal, Non-fatal, Lost-time
  gender       String?
  count        Int
  createdAt    DateTime @default(now())
}

model FS1EmployeeTraining {
  id             String  @id @default(uuid())
  companyId      String
  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgUnitId      String
  orgUnit        OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  year           Int
  quarter        Int?
  gender         String
  trainingHours  Float
  employeeCount  Int
  createdAt      DateTime @default(now())
}

model FS1EmployeeTurnover {
  id            String  @id @default(uuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgUnitId     String
  orgUnit       OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  year          Int
  quarter       Int?
  gender        String
  turnoverType  String  // Voluntary, Involuntary
  count         Int
  createdAt     DateTime @default(now())
}

// ─── E1: Climate Change ─────────────────────────────────────────

model ActivityCategory {
  id              String  @id @default(uuid())
  name            String  @unique
  subcategories   ActivitySubcategory[]
}

model ActivitySubcategory {
  id              String  @id @default(uuid())
  name            String
  categoryId      String
  category        ActivityCategory @relation(fields: [categoryId], references: [id])
  emissionSource  String?
  scope           String  // Scope 1, Scope 2, Scope 3
  unit            String?
  emissionFactor  Float?
  emissionFactorUnit String?

  @@unique([name, categoryId])
}

model FE1EmissionActivityData {
  id                String   @id @default(uuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgUnitId         String
  orgUnit           OrgUnit  @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  year              Int
  month             Int?
  activityCategory  String
  activitySubcat    String
  calcMethod        String   // consumption, expenditure
  quantity          Float
  unit              String
  emissionFactor    Float?
  totalEmissions    Float?   // tCO2e
  scope             String
  currency          String?
  amount            Float?
  sourceDoc         String?
  createdAt         DateTime @default(now())
}

model FE1GHGInventory {
  id               String  @id @default(uuid())
  companyId        String
  company          Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgUnitId        String
  orgUnit          OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  year             Int
  scope            String
  totalEmissions   Float   // tCO2e
  employeeCount    Int?
  intensity        Float?  // tCO2e per employee
  createdAt        DateTime @default(now())

  @@unique([companyId, orgUnitId, year, scope])
}

model SBTiTarget {
  id                String  @id @default(uuid())
  companyId         String
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  baseYear          Int
  targetYear        Int
  method            String  // absolute, intensity, renewable_share
  reductionPct      Float?
  absoluteTarget    Float?
  scope             String  // Scope 1+2, Scope 3, All
  description       String?
  createdAt         DateTime @default(now())
}

// ─── Data Connections ───────────────────────────────────────────

model DataConnection {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  type         String   // postgresql, mysql, sqlserver, aws_rds, rest_api
  config       Json     // encrypted connection details
  status       String   @default("disconnected") // connected, disconnected, error
  lastSyncAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── PCF Module — Product Carbon Footprint (Sprint 1) ───────────
// Sector-agnostic graph of Products → BOM → Components → EmissionFactors
// → PcfCalculations.  Used by Electronics today, Automotive in Q4 2026,
// Real Estate + Financial Services in Q1 2027.  Functional unit + lifecycle
// stage fields are generic so an SSD, a vehicle, a building, and a
// financial instrument are all just Products with different stages active.

model Product {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgUnitId       String?
  orgUnit         OrgUnit? @relation(fields: [orgUnitId], references: [id])

  sku             String
  name            String
  sector          String   // electronics | automotive | real_estate | financial | generic
  functionalUnit  String   // "1 SSD module", "1 vehicle", "1 m2 leasable"
  declaredUnit    String   // usually same as functionalUnit for Lite
  massKg          Float?
  lifetimeYears   Float?
  methodology     String   @default("ISO_14067")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  boms            BillOfMaterialsItem[]
  processes       ProcessStep[]
  calculations    PcfCalculation[]
  scenarios       SavedScenario[]

  @@unique([companyId, sku])
  @@index([companyId, sector])
}

model Component {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  materialClass   String   // "aluminum_6061", "pcb_fr4", "li_ion_nmc", ...
  supplierName    String?
  originCountry   String?
  primaryDataFlag Boolean  @default(false)

  createdAt       DateTime @default(now())
  bomItems        BillOfMaterialsItem[]

  @@index([companyId, materialClass])
}

model BillOfMaterialsItem {
  id             String    @id @default(uuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  componentId    String
  component      Component @relation(fields: [componentId], references: [id])
  quantity       Float
  unit           String    // kg, pcs, m, m2
  scrapRatePct   Float     @default(0)
  lifecycleStage String    // A1, A2, A3, A4, B1, C1 (EN 15978 stages)
  chosenFactorId String?   // FK resolved at calculate-time (soft, no constraint)
  sortOrder      Int       @default(0)

  @@index([productId])
  @@index([componentId])
}

// EmissionFactor is global — not scoped per company — because factors come
// from public datasets (Ecoinvent, DEFRA, EPA) or from supplier submissions
// that any buyer could reuse.  `source=supplier_primary` rows carry a
// supplierCompanyId to preserve provenance.
model EmissionFactor {
  id                 String   @id @default(uuid())
  source             String   // ecoinvent_3_10 | defra_2024 | epa_ghg_2024 | supplier_primary
  activityName       String
  materialClass      String?  // normalised tag for BOM classifier matching
  region             String   // GLO | EU | US | VN | MY | CN | ...
  value              Float
  unit               String   // kgCO2e per <functionalUnit>
  functionalUnit     String   // "kg" | "kWh" | "pcs" | "m3"
  vintage            Int
  uncertaintyStd     Float?   // for Monte Carlo
  supplierCompanyId  String?  // set when source=supplier_primary
  notes              String?
  createdAt          DateTime @default(now())

  @@index([source, region, vintage])
  @@index([activityName])
  @@index([materialClass, region])
}

model ProcessStep {
  id             String  @id @default(uuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  lifecycleStage String
  siteId         String?
  energyKwh      Float?
  waterM3        Float?
  wasteKg        Float?
  emissionsKg    Float?
  notes          String?

  createdAt      DateTime @default(now())

  @@index([productId, lifecycleStage])
}

model PcfCalculation {
  id                String   @id @default(uuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  runAt             DateTime @default(now())
  engineVersion     String
  totalKgCo2e       Float
  uncertaintyLow    Float?
  uncertaintyHigh   Float?
  primaryDataPct    Float    // computed share 0..1
  breakdownByStage  Json     // { A1: 42.1, A2: 3.4, A3: 11.0, ... }
  breakdownByComp   Json     // [{ componentId, kgCo2e, pct }]
  factorSnapshot    Json     // which factor IDs + vintages were used
  status            String   @default("draft") // draft | final | verified

  verifications     PcfVerification[]

  @@index([productId, runAt])
}

model PcfVerification {
  id               String   @id @default(uuid())
  calculationId    String
  calculation      PcfCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  verifierName     String
  verifierOrg      String?
  verifiedAt       DateTime
  standard         String   // ISO_14067 | PEF | GHG_Product
  evidenceUrl      String?
  notes            String?

  createdAt        DateTime @default(now())
}

// ─── Sector Pack Framework (PCF-05) ─────────────────────────────
// Sector packs are data, not code — loaded from backend/src/sectors/*/pack.json
// at boot by sectorLoader.js.  Each pack bundles KPIs, materiality starters,
// emission factors, and report templates.  Adding a new sector does NOT
// require frontend changes.

model SectorPack {
  id          String      @id @default(uuid())
  key         String      @unique  // electronics | automotive | real_estate | financial | generic
  name        String
  version     String
  enabled     Boolean     @default(true)
  manifest    Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  kpis        SectorKpi[]
}

model SectorKpi {
  id            String     @id @default(uuid())
  packId        String
  pack          SectorPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  code          String     // TC-HW-410a.1
  name          String
  unit          String
  framework     String     // SASB | ESRS | RBA | custom
  category      String     // environmental | social | governance | product
  formula       String?    // how to compute from existing data
  aggregation   String?    // sum | avg | ratio
  sortOrder     Int        @default(0)

  @@unique([packId, code])
}

// One row per company — tracks which sector pack is currently active.
// Selected at onboarding, switchable in Settings.
model CompanySectorSelection {
  companyId   String   @id
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sectorKey   String
  selectedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Benchmark Cohorts (PCF-08) ─────────────────────────────────
// Per-sector × KPI × region aggregated statistics.  Recomputed nightly
// (or on demand) by `services/benchmarkEngine.js`.  k-anonymity: a row
// only exists — and is only returned — when cohortSize ≥ K_MIN (10).
// Cohorts with <50 contributors have small Laplace noise added to p50.
model BenchmarkCohort {
  id            String   @id @default(uuid())
  sectorKey     String
  kpiCode       String   // matches SectorKpi.code (or a product-level synthetic key)
  region        String   // GLO for global, or ISO 2-letter / region code
  cohortSize    Int      // number of unique companies contributing
  p25           Float
  p50           Float
  p75           Float
  unit          String
  lastUpdatedAt DateTime @default(now())

  @@unique([sectorKey, kpiCode, region])
  @@index([sectorKey, region])
}

// ─── Saved What-If Scenarios (PCF-04 extension) ─────────────────
// Allows users to save and revisit their what-if simulations.  Each
// scenario belongs to a specific product and stores the overrides
// as JSON + the last computed baseline/scenario results.
model SavedScenario {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  overrides      Json     // the full overrides object
  baselineResult Json?    // last computed baseline snapshot
  scenarioResult Json?    // last computed scenario snapshot
  deltaKgCo2e    Float?
  deltaPct       Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId])
}

// ─── Supplier Scope 3 Portal (SUP-01) ──────────────────────────
// The supplier portal is a separate mini-app — suppliers receive an
// email with a scoped, time-limited link, land on a branded mini-site,
// submit data, and leave.  No Triple I account needed.  All data
// flows into the buyer's Scope 3 inventory with primaryDataFlag=true.

model Supplier {
  id              String   @id @default(uuid())
  buyerCompanyId  String
  buyerCompany    Company  @relation(fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  name            String
  contactEmail    String
  country         String
  annualSpendUsd  Float?
  category        String?  // tier1_direct, tier1_indirect, logistics, services
  riskScore       Float?
  createdAt       DateTime @default(now())

  requests        SupplierDataRequest[]

  @@unique([buyerCompanyId, contactEmail])
  @@index([buyerCompanyId])
}

model SupplierDataRequest {
  id              String   @id @default(uuid())
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  reportingYear   Int
  scope3Category  String   // cat1_purchased_goods, cat4_transportation, cat6_business_travel, etc.
  status          String   @default("sent") // sent | opened | submitted | approved | rejected
  token           String   @unique
  tokenExpiresAt  DateTime
  sentAt          DateTime @default(now())
  submittedAt     DateTime?
  approvedAt      DateTime?
  submission      Json?    // the supplier's form payload
  dataQuality     String?  // primary | spend_based | secondary

  @@index([supplierId])
  @@index([token])
}

// ─── Real Estate (RE-01) ────────────────────────────────────────
// Asset-level granularity — each building is a reporting unit with its
// own energy records, certifications, and CRREM stranding pathway.

model RealEstateAsset {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  assetClass       String   // office | retail | residential | industrial | logistics | hotel | mixed
  tenure           String   // owned | leased
  grossFloorAreaM2 Float
  netLeasableM2    Float?
  yearBuilt        Int?
  yearAcquired     Int?
  country          String
  city             String
  latitude         Float?
  longitude        Float?
  certifications   Json?    // [{ scheme: "LEED", level: "Gold", year: 2021 }]
  tenantCount      Int?
  occupancyPct     Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  energyRecords    AssetEnergyRecord[]
  crremPathways    AssetCrremPathway[]

  @@index([companyId])
  @@index([companyId, assetClass])
}

model AssetEnergyRecord {
  id         String          @id @default(uuid())
  assetId    String
  asset      RealEstateAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  year       Int
  month      Int?
  fuel       String   // electricity | natural_gas | district_heat | district_cool | oil
  quantity   Float
  unit       String   // kWh | m3 | litre | MWh
  cost       Float?
  currency   String?
  sourceDoc  String?
  createdAt  DateTime @default(now())

  @@index([assetId, year])
}

model AssetCrremPathway {
  id                 String          @id @default(uuid())
  assetId            String
  asset              RealEstateAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  pathway            String   // 1.5C | 2.0C
  strandedFromYear   Int?     // null = safe past 2050
  currentKgCo2ePerM2 Float
  updatedAt          DateTime @updatedAt

  @@unique([assetId, pathway])
}

// ─── Financial Services (FS-01) ─────────────────────────────────
// PCAF methodology: 7 asset classes, each with its own attribution
// formula.  FinancialExposure holds the position; FinancedEmissionsCalc
// holds the per-exposure computed financed emissions.

model FinancialExposure {
  id                String   @id @default(uuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assetClass        String   // listed_equity | corp_bonds | business_loans | project_finance | commercial_re | mortgages | motor_vehicle_loans | sovereign
  counterpartyName  String
  counterpartyIsin  String?
  counterpartyLei   String?
  sector            String?  // NACE code
  country           String?
  outstandingAmount Float
  currency          String
  equityValue       Float?   // for attribution factor (listed equity)
  totalBalanceSheet Float?   // for corp loans
  epc               String?  // EPC rating for mortgages/CRE
  evic              Float?   // enterprise value including cash
  reportingYear     Int
  dataQualityScore  Int      // PCAF 1 (best) to 5 (worst)
  createdAt         DateTime @default(now())

  financedEmissions FinancedEmissionsCalc[]

  @@index([companyId, reportingYear])
  @@index([companyId, assetClass])
}

model FinancedEmissionsCalc {
  id                    String            @id @default(uuid())
  exposureId            String
  exposure              FinancialExposure @relation(fields: [exposureId], references: [id], onDelete: Cascade)
  reportingYear         Int
  attributionFactor     Float   // outstanding / EVIC or similar per PCAF
  counterpartyScope1    Float?  // tCO2e total
  counterpartyScope2    Float?
  counterpartyScope3    Float?
  financedScope1        Float
  financedScope2        Float
  financedScope3        Float?
  waci                  Float?  // weighted avg carbon intensity
  calcAt                DateTime @default(now())
  factorSnapshot        Json

  @@index([exposureId])
}

// ─── ISO → GRI Bridge ──────────────────────────────────────────
// Maps ISO management system data outputs to GRI 2021 disclosures.
// The mapping matrix is the canonical rule source; the classification
// engine applies it to ingested ISO data to produce gap analysis and
// GRI disclosure drafts.

model IsoGriMappingRule {
  id              String   @id @default(uuid())
  isoStandard     String   // ISO_14001, ISO_45001, ISO_50001, ISO_14064, ISO_9001, ISO_27001, ISO_26000, ISO_20400
  isoClause       String   // e.g., "6.1.2", "A.5"
  isoDataCaptured String   // Human-readable description of what data the ISO clause produces
  griCode         String   // e.g., "GRI 305-1", "GRI 403-2", "GRI 3-1"
  coverageLevel   String   // FULL | PARTIAL | SUPPORTING
  notes           String?  // Gaps, caveats, guidance
  tripleIModule   String?  // Which Triple I module handles this data
  version         String   @default("1.0")
  createdAt       DateTime @default(now())

  @@index([isoStandard, isoClause])
  @@index([griCode])
  @@index([version])
}

// Per-company ISO data ingestion records — what ISO data the customer
// has uploaded or connected.  Each record is classified against the
// mapping rules to produce a GRI coverage assessment.
model IsoDataIngestion {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isoStandard     String   // ISO_14001, ISO_45001, etc.
  isoClause       String
  dataDescription String?
  dataValue       String?  // The actual data point or summary
  sourceFile      String?  // Original file name
  year            Int
  classifiedGri   String?  // The GRI disclosure this was classified to
  coverageLevel   String?  // FULL | PARTIAL | SUPPORTING (from the rule)
  ruleVersion     String?  // Which rule version was used
  createdAt       DateTime @default(now())

  @@index([companyId, isoStandard])
  @@index([companyId, classifiedGri])
}

// Public readiness assessment results — lead-gen questionnaire that
// estimates GRI coverage based on ISO certifications and practices.
// No authentication required; results are keyed by a shareable token.
model ReadinessAssessment {
  id              String   @id @default(uuid())
  token           String   @unique @default(uuid())
  contactName     String
  contactEmail    String
  companyName     String
  phone           String?
  answers         Json
  overallScore    Float
  topicScores     Json     // { "GRI 2": 15, "GRI 3": 30, ... }
  recommendations Json?
  createdAt       DateTime @default(now())

  @@index([contactEmail])
}

// Per-company GRI gap analysis snapshot — computed from the ingested
// ISO data and the mapping rules.  Refreshed on each ingestion or
// on-demand recalculation.
model GriGapAnalysis {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  griTopicFamily  String   // e.g., "GRI 305", "GRI 403", "GRI 302"
  griCode         String   // Specific disclosure code
  griName         String   // Human-readable name
  status          String   // COVERED | PARTIAL | GAP
  coveringSources Json?    // Array of { isoStandard, isoClause, coverageLevel }
  recommendedAction String? // What the customer should do to close the gap
  year            Int
  computedAt      DateTime @default(now())

  @@unique([companyId, griCode, year])
  @@index([companyId, year])
}

// ─── Sites & Geospatial Foundation ──────────────────────────────
model Site {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgUnitId       String?
  orgUnit         OrgUnit? @relation(fields: [orgUnitId], references: [id])
  name            String
  siteType        String   // manufacturing | office | warehouse | retail | other
  country         String
  address         String?
  latitude        Float?
  longitude       Float?
  waterStress     String?  // Low | Low-Medium | Medium-High | High | Extremely High (from WRI Aqueduct)
  protectedArea   Json?    // { inProtectedArea: bool, nearbyAreas: [{ name, designation, distanceKm }] }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  waterActivities WaterActivity[]
  biodiversityAssessments BiodiversityAssessment[]

  @@unique([companyId, name])
  @@index([companyId])
}

// ─── E3 Water Resources ─────────────────────────────────────────
model WaterActivity {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  siteId          String
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  year            Int
  month           Int?
  source          String   // surface | ground | third_party | seawater | produced | rainwater
  flowType        String   // withdrawal | discharge | consumption
  quantity        Float    // in m³
  unit            String   @default("m3")
  destination     String?  // surface_water | groundwater | seawater | third_party | other
  quality         String?  // freshwater | other_water
  recycledReused  Boolean  @default(false)
  sourceDoc       String?
  createdAt       DateTime @default(now())

  @@index([companyId, year])
  @@index([siteId, year])
}

// ─── E4 Biodiversity ────────────────────────────────────────────
model BiodiversityAssessment {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  siteId          String
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  year            Int
  assessmentType  String   // tnfd_leap | gri_101 | screening
  leapPhase       String?  // locate | evaluate | assess | prepare
  landAreaHa      Float?
  landUseChange   String?  // converted | restored | maintained | degraded
  ecosystemType   String?  // forest | wetland | grassland | marine | freshwater | urban | agricultural | other
  directDrivers   Json?    // { landUseChange: bool, resourceExploitation: bool, climateChange: bool, pollution: bool, invasiveSpecies: bool }
  ecosystemServices Json?  // structured questionnaire responses
  peopleImpacts   Json?    // impacts on indigenous peoples / local communities
  accessBenefitSharing Boolean? // genetic resources used?
  status          String   @default("draft") // draft | complete | verified
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, year])
  @@index([siteId])
}
