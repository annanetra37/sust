[
  {
    "code": "PCAF-TOTAL-FE",
    "name": "Total financed emissions",
    "unit": "tCO2e",
    "framework": "PCAF",
    "category": "environmental",
    "formula": "sum(exposure.attributedEmissions)",
    "aggregation": "sum",
    "sortOrder": 10
  },
  {
    "code": "PCAF-WACI",
    "name": "Weighted average carbon intensity",
    "unit": "tCO2e/EUR M revenue",
    "framework": "PCAF",
    "category": "environmental",
    "formula": "sum(weight_i * intensity_i) where weight_i = exposure_i / totalAUM",
    "aggregation": "weighted_avg",
    "sortOrder": 20
  },
  {
    "code": "PCAF-COV",
    "name": "Percentage of AUM covered by financed emissions calculation",
    "unit": "%",
    "framework": "PCAF",
    "category": "environmental",
    "formula": "sum(exposure.AUM where hasEmissions=true) / sum(exposure.AUM)",
    "aggregation": "ratio",
    "sortOrder": 30
  },
