    "code": "SFDR-PAI1",
    "name": "GHG emissions (PAI 1)",
    "unit": "tCO2e",
    "framework": "SFDR_PAI",
    "category": "environmental",
    "formula": "sum(investee.scope1 + investee.scope2)",
    "aggregation": "sum",
    "sortOrder": 120
  },
  {
    "code": "SFDR-PAI2",
    "name": "Carbon footprint (PAI 2)",
    "unit": "tCO2e/EUR M invested",
    "framework": "SFDR_PAI",
    "category": "environmental",
    "formula": "sum(investee.attributedEmissions) / (totalAUM / 1e6)",
    "aggregation": "ratio",
    "sortOrder": 130
  },
  {
    "code": "SFDR-PAI3",
    "name": "GHG intensity of investee companies (PAI 3)",
    "unit": "tCO2e/EUR M revenue",
    "framework": "SFDR_PAI",
    "category": "environmental",
    "formula": "sum(weight_i * (investee_i.scope1 + investee_i.scope2) / investee_i.revenue)",
